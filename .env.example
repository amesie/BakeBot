# Copy to .env.local and fill in. Never commit real values.
# Vercel holds the production values (Project -> Settings -> Environment Variables).

# Public (safe in browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=   # Supabase "publishable" key (replaces the old anon key; see docs/DECISIONS.md D-002)
NEXT_PUBLIC_OWNER_WHATSAPP=+27XXXXXXXXX
NEXT_PUBLIC_PROOF_EMAIL=thebakebot@gmail.com

# Server only - never NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=              # Supabase "secret" key (sb_secret_...) or legacy service_role key
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=                      # optional; default gemini-3.1-flash-lite (D-064)
GEMINI_EMBED_MODEL=                     # optional; default gemini-embedding-001 (768 dimensions)
CHAT_SIMILARITY_THRESHOLD=              # optional; default 0.6 (D-064)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ENABLED=false                  # true only after Meta business verification
CRON_SECRET=                            # shared secret for pg_net -> /api/cron/* calls
EFT_BANK_DETAILS=                       # shown on confirmations for EFT orders
GMAIL_USER=thebakebot@gmail.com          # inbox for emailed proofs of payment (D-069)
GMAIL_APP_PASSWORD=                     # Google app password (2-Step Verification required)

# Local load tests only - NEVER set on Vercel (ignored there anyway)
# BAKEBOT_FAKE_MODEL=1
